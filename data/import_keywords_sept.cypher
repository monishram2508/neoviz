MATCH (w:Work {title: "Mera Aangan"}), (g:Genre {name: "Essay"}) MERGE (w)-[:HAS_GENRE]->(g);
MATCH (w:Work {title: "Rasm-o-Riwaaj Ek Laanat"}), (g:Genre {name: "Essay"}) MERGE (w)-[:HAS_GENRE]->(g);
MATCH (w:Work {title: "Yaadash Bakhair"}), (g:Genre {name: "Khaake"}) MERGE (w)-[:HAS_GENRE]->(g);

