CREATE (w158:Work {title: "Safarnama-e-Yurop", author: "Sughra Humayun Mirza", genre: "Travel account", year: "1926", engInfo: "Safarnama-e-Yurop (trans. Travelogue of Europe) is a 1926 travel account by Sughra Humayun Mirza describing her journey through England, Germany, France, and Switzerland. During her time in Geneva she was received as a guest of the exiled Ottoman Caliph Abdulmejid II and his wife — by her own account, the first Indian woman to meet with him.", urduInfo: "", keywords: ["Sughra Humayun Mirza", "Hyderabad", "Dakkan ‫ Urdu travel writing", "travelogue", "safarnama", "women’s travel writing", "Muslim women’s travel writing", "South Asian travel writing", "Indian travel writing", "life writing", "autobiography", "female autobiography", "self-writing", "autobiographical subjectivity", "firstperson narration", "eyewitness narrative", "observational prose", "documentary prose", "descriptive prose", "serialized travel writing", "travel narrative", "geographical writing", "ethnographic observation", "cultural observation", "comparative travel writing", "female travel writing", "reformist travel writing", "didactic travelogue", "political travel writing", "‫ ﻣﺳﻠ transnational writing", "dispatches", "journalistic writing", "female mobility", "pardah", "seclusion", "veil", "chador", "travel in pardah", "pardah nashin", "mastuuraat", "women’s mobility", "‫ ﻋﯾﻧﯽ ﺷﺎﮨ physical mobility", "geographical mobility", "travel and freedom", "movement", "mobility and subjectivity", "gendered mobility", "public space", "female access to public space", "female ‫ ﻧﺳﺎﺋﯽ ﺳﻔ traveller", "Muslim female traveller", "travelling woman", "travelling subject", "mobile subjectivity", "female selfhood", "gendered selfhood", "self-fashioning", "self-representation", "‫ ﭘ performative identity", "autobiographical self", "traveller’s gaze", "female gaze", "observing ‫ ﺟﻐ and being observed", "spectatorship", "cosmopolitan identity", "transnational identity", "‫ ﻋ cultural encounter