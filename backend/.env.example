# Copy this file to .env and fill in the values.
#   cp .env.example .env
# .env is gitignored and must never be committed.

# ---- required ----------------------------------------------------------

# Signs login tokens. Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everybody out.
JWT_SECRET=

# ---- the archive database ----------------------------------------------
# The Neo4j instance holding the archive. Read by the server only; never
# sent to a browser. Without these, contribution and archive endpoints
# return 503 but the rest of the app still runs.

ARCHIVE_NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
ARCHIVE_NEO4J_USERNAME=
ARCHIVE_NEO4J_PASSWORD=

# ---- moderators --------------------------------------------------------
# Comma-separated emails promoted to moderator at startup and at
# registration. Everyone else is a contributor.

MODERATOR_EMAILS=

# ---- optional ----------------------------------------------------------

# Natural-language query feature. Without it, /api/nl-query fails but
# nothing else does. Key from https://console.groq.com
GROQ_API_KEY=

# Port to listen on. Defaults to 3001.
# PORT=3001

# Serve the built frontend from this server. Defaults to on when
# NODE_ENV=production. Requires "npm run build" in the frontend directory.
# SERVE_FRONTEND=true

# Browsers allowed to call the API. Defaults to "*", which is fine when
# the frontend is served from this same server. Set it to your site's
# origin if they are hosted separately.
# CORS_ORIGIN=https://archive.example.edu

# Where the SQLite file and uploads live. Relative paths resolve against
# the backend directory, not the working directory. Point these at a
# persistent disk when deploying.
# DB_FILE=users.db
# UPLOAD_DIR=uploads
# FRONTEND_BUILD=../frontend/build
